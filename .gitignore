# Python bytecode / caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# Virtual environments
.venv/
venv/
env/
ENV/

# Packaging / build outputs
build/
dist/
release/
*.egg-info/
.eggs/
*.whl
pip-wheel-metadata/

# Native installers / archives generated by CI
*.dmg
*.msi
*.exe
*.app.zip
*.sha256
*.verification.json

# Large Minecraft / mod inputs - do not accidentally commit user content
*.mca
*.mcr
*.jar
*.mrpack
*.zip
*.7z
*.rar
*.litematic
*.schem
*.schematic
*.world

# Allow intentionally committed tiny test fixtures when needed
!tests/fixtures/**/*.zip
!tests/fixtures/**/*.jar

# Local conversion outputs / catalogs
converted-worlds/
workspace/
catalogs/local/
reports/local/

# Secrets / signing material
.env
.env.*
!.env.example
secrets/
*.p12
*.pfx
*.pem
*.key
*.cer
*.crt
*.jks
*.keystore

# Editors / IDEs
.idea/
.vscode/
*.code-workspace
*.sublime-project
*.sublime-workspace

# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon\r
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Logs / temporary files
*.log
*.tmp
*.temp
*.bak
*.swp
*~
